# PostgreSQL. The app connects as netrics_app (RLS-enforced tenant isolation);
# migrations must run as the owner role via DATABASE_MIGRATION_URL. The
# defaults match docker-compose.yml (host port 5433, chosen to avoid
# colliding with other local PostgreSQL containers on 5432). Migrations create
# the roles without credentials; migrate then assigns the passwords below, so
# the first-run order is: pnpm db:up -> pnpm db:migrate -> pnpm dev.
DATABASE_URL=postgres://netrics_app:netrics_app@localhost:5433/netrics
DATABASE_MIGRATION_URL=postgres://netrics:netrics@localhost:5433/netrics

# Passwords migrate assigns to the netrics_app / netrics_scheduler login roles.
# Outside production they default to the role names (matching the URLs above).
# In production they must be real secrets (>= 24 chars, e.g.
# `openssl rand -base64 32`); migrate refuses to finish while a role still
# accepts its public development password. api/worker/scheduler refuse to
# start on a superuser or BYPASSRLS connection.
# NETRICS_APP_DB_PASSWORD=
# NETRICS_SCHEDULER_DB_PASSWORD=

# Scheduler-role connection used by NETRICS_ROLE=worker / =scheduler (job
# claiming, due-sync planning, heartbeats). The dev default matches the
# migration-created dev role; REQUIRED in production for worker/scheduler.
DATABASE_SCHEDULER_URL=postgres://netrics_scheduler:netrics_scheduler@localhost:5433/netrics

# apps/server — worker/scheduler loops.
SCHEDULER_POLL_MS=5000
WORKER_POLL_MS=1000
WORKER_CONCURRENCY=4

# apps/server
PORT=3001
HOST=0.0.0.0
LOG_LEVEL=info
NETRICS_ROLE=api

# apps/server — auth (better-auth). BETTER_AUTH_SECRET must be >= 32 chars and
# is REQUIRED when NODE_ENV=production; the value below is an intentionally
# insecure dev default (generate a real one, e.g. `openssl rand -base64 32`).
# BETTER_AUTH_URL is the public base URL of the API; WEB_ORIGIN is the web
# app origin allowed for credentialed CORS requests. Both must be https:// in
# production. The dev secret and key below are rejected in production.
BETTER_AUTH_SECRET=netrics-dev-only-insecure-secret-000000
BETTER_AUTH_URL=http://localhost:3001
WEB_ORIGIN=http://localhost:3000
# Where TVs send people to approve their pairing code. Defaults to
# <WEB_ORIGIN>/devices/approve. The hosted service sets its short domain; a
# URL without a path makes the QR code open <URL>/<CODE>.
# NETRICS_PAIRING_URL=https://netrics.tv

# apps/server — who may create accounts. "closed" (default in production):
# while no account exists, the api logs a one-time setup URL
# (<WEB_ORIGIN>/setup?token=…); only that token can create the first account,
# which then owns the first workspace. "open": anyone may sign up (hosted
# service; default outside production). NETRICS_SETUP_TOKEN (>= 24 chars)
# fixes the token instead of generating and logging one.
# NETRICS_SIGNUP=closed
# NETRICS_SETUP_TOKEN=

# apps/server — outbound email (verification, password reset). Without SMTP,
# links are logged in development only; elsewhere sending is refused.
# SMTP_URL=smtps://user:password@smtp.example.com:465
# MAIL_FROM=netrics <no-reply@example.com>

# apps/server — instance master key for encrypting connection credentials
# (AES-256-GCM envelopes in connections.credentials_encrypted). Must be base64
# of exactly 32 bytes and is REQUIRED when NODE_ENV=production; the value below
# is an intentionally insecure dev default (generate a real one with
# `openssl rand -base64 32`).
APP_ENCRYPTION_KEY=bmV0cmljcy1kZXYtb25seS1pbnNlY3VyZS1rZXkhITE=
# Retired keys (comma-separated) still needed to decrypt existing credentials
# during a rotation. See README "Rotating the encryption key".
# APP_ENCRYPTION_KEYS_PREVIOUS=

# apps/web — where the web server reaches the API (server-side fetch).
NETRICS_API_URL=http://localhost:3001
# apps/web — hosted service only: requests on these hosts (comma-separated)
# redirect to <NETRICS_APP_ORIGIN>/devices/approve, passing on a code from
# the path or ?code=. Both unset (self-hosting): no redirect.
# NETRICS_PAIRING_HOST=netrics.tv
# NETRICS_APP_ORIGIN=https://app.netrics.so

# Release identity baked into images by the release workflow (safe dev defaults).
APP_VERSION=0.0.0-dev
GIT_SHA=dev

# apps/web — shown on the status page (inlined at build time by Next.js).
NEXT_PUBLIC_APP_VERSION=0.0.0-dev
NEXT_PUBLIC_GIT_SHA=dev
