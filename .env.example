# PostgreSQL used by apps/server and packages/database (drizzle-kit migrate).
# The default matches docker-compose.yml (host port 5433, chosen to avoid
# colliding with other local PostgreSQL containers on 5432).
DATABASE_URL=postgres://netrics:netrics@localhost:5433/netrics

# apps/server
PORT=3001
HOST=0.0.0.0
LOG_LEVEL=info
NETRICS_ROLE=api

# apps/web — where the web server reaches the API (server-side fetch).
NETRICS_API_URL=http://localhost:3001
