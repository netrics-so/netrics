# PostgreSQL. The app connects as netrics_app (RLS-enforced tenant isolation);
# migrations must run as the owner role via DATABASE_MIGRATION_URL. The
# defaults match docker-compose.yml (host port 5433, chosen to avoid
# colliding with other local PostgreSQL containers on 5432). The roles and
# dev passwords are created by the migration itself, so the first-run order
# is: pnpm db:up -> pnpm db:migrate -> pnpm dev.
DATABASE_URL=postgres://netrics_app:netrics_app@localhost:5433/netrics
DATABASE_MIGRATION_URL=postgres://netrics:netrics@localhost:5433/netrics

# apps/server
PORT=3001
HOST=0.0.0.0
LOG_LEVEL=info
NETRICS_ROLE=api

# apps/server — auth (better-auth). BETTER_AUTH_SECRET must be >= 32 chars and
# is REQUIRED when NODE_ENV=production; the value below is an intentionally
# insecure dev default (generate a real one, e.g. `openssl rand -base64 32`).
# BETTER_AUTH_URL is the public base URL of the API; WEB_ORIGIN is the web
# app origin allowed for credentialed CORS requests.
BETTER_AUTH_SECRET=netrics-dev-only-insecure-secret-000000
BETTER_AUTH_URL=http://localhost:3001
WEB_ORIGIN=http://localhost:3000

# apps/server — instance master key for encrypting connection credentials
# (AES-256-GCM envelopes in connections.credentials_encrypted). Must be base64
# of exactly 32 bytes and is REQUIRED when NODE_ENV=production; the value below
# is an intentionally insecure dev default (generate a real one with
# `openssl rand -base64 32`).
APP_ENCRYPTION_KEY=bmV0cmljcy1kZXYtb25seS1pbnNlY3VyZS1rZXkhITE=

# apps/web — where the web server reaches the API (server-side fetch).
NETRICS_API_URL=http://localhost:3001

# Release identity baked into images by the release workflow (safe dev defaults).
APP_VERSION=0.0.0-dev
GIT_SHA=dev

# apps/web — shown on the status page (inlined at build time by Next.js).
NEXT_PUBLIC_APP_VERSION=0.0.0-dev
NEXT_PUBLIC_GIT_SHA=dev
