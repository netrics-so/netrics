{
  "name": "netrics",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@10.34.5",
  "scripts": {
    "build": "pnpm -r build",
    "dev": "pnpm --filter @netrics/server... build && pnpm --parallel --stream --filter @netrics/web --filter @netrics/server dev",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc -b && pnpm --filter @netrics/web typecheck",
    "test": "vitest run",
    "db:up": "docker compose up -d --wait postgres",
    "db:down": "docker compose down",
    "db:migrate": "pnpm --filter @netrics/database migrate",
    "db:generate": "pnpm --filter @netrics/database generate",
    "setup": "pnpm install && pnpm db:up && pnpm build && pnpm db:migrate"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "26.6.2",
    "eslint": "10.11.0",
    "prettier": "3.9.8",
    "typescript": "5.9.3",
    "typescript-eslint": "8.70.0",
    "vitest": "5.0.1"
  }
}
