{
  "name": "netrics",
  "version": "0.1.0",
  "license": "AGPL-3.0-only",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@10.34.5",
  "scripts": {
    "build": "pnpm -r build",
    "dev": "pnpm --filter @netrics/server... build && pnpm --parallel --stream --filter @netrics/web --filter @netrics/server dev",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc -b && pnpm --filter @netrics/web typecheck",
    "test": "vitest run",
    "db:up": "docker compose up -d --wait postgres",
    "db:down": "docker compose down",
    "db:migrate": "pnpm --filter '@netrics/server^...' build && pnpm --filter @netrics/server migrate",
    "db:generate": "pnpm --filter @netrics/database generate",
    "setup": "pnpm install && pnpm db:up && pnpm build && pnpm db:migrate",
    "openapi": "pnpm --filter @netrics/server openapi",
    "openapi:check": "pnpm --filter @netrics/server openapi:check",
    "vectors:compact": "UPDATE_COMPACT_VECTORS=1 vitest run packages/domain/src/compact-format.test.ts -t \"compact number vectors\"",
    "vectors:studio": "UPDATE_STUDIO_VECTORS=1 vitest run packages/domain/src/studio-layout.test.ts -t \"test vectors\"",
    "vectors:formats": "UPDATE_FORMAT_VECTORS=1 vitest run packages/domain/src/screen-formats.test.ts -t \"test vectors\""
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "26.6.2",
    "eslint": "10.11.0",
    "prettier": "3.9.8",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.0",
    "vitest": "5.0.1"
  }
}
