    "Not recommended. Allows plain HTTP to servers on your local network, and a self-signed certificate that is trusted on first use.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Not recommended. Allows plain HTTP to servers on your local network, and a self-signed certificate that is trusted on first use."
