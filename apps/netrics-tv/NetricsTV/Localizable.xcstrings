        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nicht empfohlen. Erlaubt einfaches HTTP zu Servern in deinem lokalen Netzwerk und ein selbstsigniertes Zertifikat, dem bei der ersten Verbindung vertraut wird."
          }
        }
      }
