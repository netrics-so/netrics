<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!--
	The app's strings live in NetricsUI's resource bundle (shared with the
	tvOS app); the app itself declares its languages here (ADR 0016).
	InfoPlist.xcstrings translates the keys below.
	-->
	<key>CFBundleLocalizations</key>
	<array>
		<string>en</string>
		<string>de</string>
	</array>
	<!-- The App Group that holds the caches (CacheLocation, Signing.xcconfig). -->
	<key>NetricsAppGroup</key>
	<string>$(NETRICS_APP_GROUP)</string>
	<!-- HTTPS and the system's standard cryptography only (#417 checks the answers). -->
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<!--
	Plain HTTP only to local-network hosts (ADR 0010, ADR 0021). Never
	NSAllowsArbitraryLoads: the app refuses plain HTTP to public hosts in
	code too (TransportPolicy), and only when the user turned on
	"Allow insecure connections".
	-->
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsLocalNetworking</key>
		<true/>
	</dict>
	<!-- iOS asks before the app reaches a server on the local network. -->
	<key>NSLocalNetworkUsageDescription</key>
	<string>netrics TV connects to the netrics server on your network that you choose, to show its dashboard.</string>
	<!-- One window: a device is one pairing (ADR 0021, section 3). -->
	<key>UIApplicationSceneManifest</key>
	<dict>
		<key>UIApplicationSupportsMultipleScenes</key>
		<false/>
	</dict>
	<key>UILaunchScreen</key>
	<dict>
		<key>UIColorName</key>
		<string>LaunchBackground</string>
	</dict>
</dict>
</plist>
