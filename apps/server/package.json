{
  "name": "@netrics/server",
  "version": "0.0.0",
  "license": "AGPL-3.0-only",
  "private": true,
  "type": "module",
  "files": [
    "dist",
    "!dist/**/*.test.*",
    "!dist/**/test-db.*",
    "!dist/**/test-helpers.*",
    "!dist/**/*.tsbuildinfo"
  ],
  "scripts": {
    "build": "tsc -b",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "migrate": "tsx src/migrate.ts",
    "openapi": "tsx src/openapi-generate.ts",
    "openapi:check": "tsx src/openapi-generate.ts --check"
  },
  "dependencies": {
    "@better-auth/drizzle-adapter": "1.7.5",
    "@fastify/cors": "11.3.0",
    "@fastify/swagger": "9.9.0",
    "@netrics/connector-runtime": "workspace:*",
    "@netrics/connector-sdk": "workspace:*",
    "@netrics/connectors": "workspace:*",
    "@netrics/contracts": "workspace:*",
    "@netrics/database": "workspace:*",
    "@netrics/domain": "workspace:*",
    "better-auth": "1.7.5",
    "drizzle-orm": "0.45.2",
    "fastify": "5.12.5",
    "fastify-type-provider-zod": "7.0.0",
    "nodemailer": "10.0.10",
    "pino": "10.3.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/node": "26.6.2",
    "openapi-types": "12.1.3",
    "tsx": "4.23.15",
    "typescript": "5.9.3"
  }
}
