    },
    "./app-store-connect": {
      "types": "./dist/app-store-connect/index.d.ts",
      "default": "./dist/app-store-connect/index.js"
    },
    "./demo": {
      "types": "./dist/demo/index.d.ts",
      "default": "./dist/demo/index.js"
    },
    "./google-search-console": {
      "types": "./dist/google-search-console/index.d.ts",
      "default": "./dist/google-search-console/index.js"
    },
    "./vercel": {
      "types": "./dist/vercel/index.d.ts",
      "default": "./dist/vercel/index.js"
    }
  },
  "scripts": {
    "build": "tsc -b"
  },
  "dependencies": {
    "@netrics/connector-sdk": "workspace:*",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "typescript": "5.9.3"
